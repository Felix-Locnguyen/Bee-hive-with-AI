# PostgreSQL local — copy file nay thanh .env roi chinh password
DATABASE_URL=postgresql://postgres:123456@localhost:5432/beehive_management

# --- Camera pipeline (Demo v1) ---
SCAN_INTERVAL_SEC=25          # Demo 20-30s | Production 180-300s
ALERT_COOLDOWN_SEC=90         # 60-120s, tinh theo (hive_id, alert_type)
MAX_IMAGES_PER_HIVE=200       # Rolling retention moi thùng
MJPEG_FPS=12                  # 10-15
MAX_CONCURRENT_STREAMS=5
DEMO_MODE=true                # mau frame o moc giay co thien dich
CAMERA_TOKEN_SECRET=change-me-in-production
